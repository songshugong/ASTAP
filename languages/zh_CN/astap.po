msgid "Astrometric Stacking Program and fits viewer (ASTAP)"
msgstr "天文叠加与 FITS 查看器 (ASTAP)"

msgid "Declination"
msgstr "Declination"

msgid "Right ascension"
msgstr "Right ascension"

msgid "Browse & preview fits files"
msgstr "Browse & preview fits files"

msgid "Right ascension of reference pixel. Normally in the middle of the image. Format 23 30 00.0 or 23.500. Double click to retrieve position from database"
msgstr "Right ascension of reference pixel. Normally in the middle of the image. Format 23 30 00.0 or 23.500. Double click to retrieve position from database"

msgid "Show stack menu. CTRL-A"
msgstr "Show stack menu. CTRL-A"

msgid "Find an astrometric solution for the image in the viewer.\n\nChecklist for successful solving:\n\n- At least 30 stars are visible.\n- Reasonable round stars.\n- Image dimensions at least 1280x960 pixels.\n- An approximate position is available for a spiral search\n- Correct image height in degrees specified. See stack menu tab alignment.\n- Image is not stretched or heavily photo-shopped."
msgstr "Find an astrometric solution for the image in the viewer.\n\nChecklist for successful solving:\n\n- At least 30 stars are visible.\n- Reasonable round stars.\n- Image dimensions at least 1280x960 pixels.\n- An approximate position is available for a spiral search\n- Correct image height in degrees specified. See stack menu tab alignment.\n- Image is not stretched or heavily photo-shopped."

msgid "Solve"
msgstr "求解"

msgid "Save FITS file with plate solution"
msgstr "Save FITS file with plate solution"

msgid "Use WCS, SIP or DSS polynomial for indicating the position. SIP is available for Astrometry.net solutions and DSS polynomial for images from the DSS survey. A red background is indicating \"no valid\" solution for this option."
msgstr "Use WCS, SIP or DSS polynomial for indicating the position. SIP is available for Astrometry.net solutions and DSS polynomial for images from the DSS survey. A red background is indicating \"no valid\" solution for this option."

msgid "Data range"
msgstr "数据范围"

msgid "Histogram:"
msgstr "直方图:"

msgid "Adjust the black level"
msgstr "Adjust the black level"

msgid "Adjust the white level."
msgstr "Adjust the white level."

msgid "At this level the pixels are displayed as black."
msgstr "At this level the pixels are displayed as black."

msgid "At this level the pixels are displayed as fully white."
msgstr "At this level the pixels are displayed as fully white."

msgid "Preset of the automatic data range adjustments."
msgstr "Preset of the automatic data range adjustments."

msgid "Stretch factor applied on displayed image. This is a  colour preserving stretch based on an asinh function."
msgstr "Stretch factor applied on displayed image. This is a  colour preserving stretch based on an asinh function."

msgid "Saturation adjust factor. The midde position is neutral.  Above is increase, below is decrease."
msgstr "Saturation adjust factor. The midde position is neutral.  Above is increase, below is decrease."

msgid "Selective colour saturation (Luminance-based Saturation Enhancement). This will enhance the colour of faint objects relative to bright objects"
msgstr "Selective colour saturation (Luminance-based Saturation Enhancement). This will enhance the colour of faint objects relative to bright objects"

msgid "Declination of reference pixel. Normally in the middle of the image. Format +89 30 00 or 89.500. Double click to retrieve position from database."
msgstr "Declination of reference pixel. Normally in the middle of the image. Format +89 30 00 or 89.500. Double click to retrieve position from database."

msgid "Inverse zoom action of the mouse wheel."
msgstr "Inverse zoom action of the mouse wheel."

msgid "Inverse 🖱️ wheel"
msgstr "反向鼠标滚轮"

msgid "Long axis is north, small axis is east,  F indicates flipped image."
msgstr "Long axis is north, small axis is east,  F indicates flipped image."

msgid "Header"
msgstr "头信息"

msgid "Table"
msgstr "表格"

msgid "Scroll through the images and tables in the FITS extension."
msgstr "Scroll through the images and tables in the FITS extension."

msgid "Orientation of the image north axis, independent of  flip settings."
msgstr "Orientation of the image north axis, independent of  flip settings."

msgid "The image is flipped. Either the east is swapped with west or north is swapped with south."
msgstr "The image is flipped. Either the east is swapped with west or north is swapped with south."

msgid "F"
msgstr "F"

msgid "hint"
msgstr "hint"

msgid "reference 1"
msgstr "reference 1"

msgid "Error accessing file!"
msgstr "访问文件出错!"

msgid "reference 2"
msgstr "reference 2"

msgid "Mount"
msgstr "Mount"

msgid "Lock unreliable, check position"
msgstr "Lock unreliable, check position"

msgid "Select rectangle"
msgstr "Select rectangle"

msgid "&File"
msgstr "文件"

msgid "Load a FITS, PNG, JPG or BPM file."
msgstr "Load a FITS, PNG, JPG or BPM file."

msgid "Load FITS or other format"
msgstr "载入 FITS 或其他格式"

msgid "Load an image file in the viewer "
msgstr "Load an image file in the viewer "

msgid "Thumbnail viewer"
msgstr "缩略图查看器"

msgid "Show FITS files as thumnails"
msgstr "Show FITS files as thumnails"

msgid "Open recent"
msgstr "最近打开"

msgid "Open recent files"
msgstr "Open recent files"

msgid "Save as FITS file"
msgstr "另存为 FITS 文件"

msgid "Save image as  32 bit, 16 bit or 8 bits FITS file. "
msgstr "Save image as  32 bit, 16 bit or 8 bits FITS file. "

msgid "Export to PNG, TIFF, PPM/PGM"
msgstr "导出为 PNG、TIFF、PPM/PGM"

msgid "Save current image as 16 bit PNG, 16 or 32 bit TIFF or 16 bit PPM/PGM. Note that 32 bit files can be re-imported."
msgstr "Save current image as 16 bit PNG, 16 or 32 bit TIFF or 16 bit PPM/PGM. Note that 32 bit files can be re-imported."

msgid "Save as JPEG, PNG or BMP"
msgstr "另存为 JPEG、PNG 或 BMP"

msgid "Save image as JPEG, PNG or BMP. These files are 8 bit and include annotations."
msgstr "Save image as JPEG, PNG or BMP. These files are 8 bit and include annotations."

msgid "Update FITS header"
msgstr "更新 FITS 头"

msgid "Update FITS header as in the memo. "
msgstr "Update FITS header as in the memo. "

msgid "Settings"
msgstr "设置"

msgid "Save settings"
msgstr "保存设置"

msgid "Save current settings"
msgstr "Save current settings"

msgid "Save settings as"
msgstr "设置另存为"

msgid "Settings will be saved as. Note that after restart the default.cfg is loaded automatically. "
msgstr "Settings will be saved as. Note that after restart the default.cfg is loaded automatically. "

msgid "Return to default settings and exit"
msgstr "恢复默认设置并退出"

msgid "Prgram will return to default settings"
msgstr "Prgram will return to default settings"

msgid "Load settings"
msgstr "载入设置"

msgid "Load a configuration file"
msgstr "Load a configuration file"

msgid "&Exit        ( and save settings)"
msgstr "退出        (并保存设置)"

msgid "Save settings and leave the program"
msgstr "Save settings and leave the program"

msgid "Stack"
msgstr "叠加"

msgid "Stack images. Short cut CTRL+A"
msgstr "Stack images. Short cut CTRL+A"

msgid "Tools"
msgstr "工具"

msgid "Solve image astrometric (plate solve)"
msgstr "天文定位求解 (Plate Solve)"

msgid "Find astrometric solution using either the internal solver or astrometry.net if selected. PNG of JPEG files will be first converted to a 8 bit FITS file with the same name."
msgstr "Find astrometric solution using either the internal solver or astrometry.net if selected. PNG of JPEG files will be first converted to a 8 bit FITS file with the same name."

msgid "Batch processing"
msgstr "批处理"

msgid "Batch processes"
msgstr "Batch processes"

msgid "Batch solve images FITS && TIFF"
msgstr "批量解析 FITS 与 TIFF 图像"

msgid "Find an astrometric (plate) solution for selected files and add to the FITS file header."
msgstr "Find an astrometric (plate) solution for selected files and add to the FITS file header."

msgid "          ☑ option \"overwrite existing solutions"
msgstr "☑ 选项“覆盖现有解析结果”"

msgid "Overwrite existing astrometric solutions"
msgstr "Overwrite existing astrometric solutions"

msgid "          ☑ option \"Calibrate\""
msgstr "☑ 选项“校准”"

msgid "Calibrate image prior to solving"
msgstr "Calibrate image prior to solving"

msgid "          ☑ option \"Add LIM_MAGN, SQM, CENTALT, AIRMASS\""
msgstr "☑ 选项“添加 LIM_MAGN、SQM、CENTALT、AIRMASS”"

msgid "Add estimated LIM-MAGN, SQM, CENTALT, AIRMASS to the file header. The display of these keywords can be configured in tab lights popup menu. For SQM enter a fixed pedestal value in viewer menu SQM report."
msgstr "Add estimated LIM-MAGN, SQM, CENTALT, AIRMASS to the file header. The display of these keywords can be configured in tab lights popup menu. For SQM enter a fixed pedestal value in viewer menu SQM report."

msgid "          ☑ option \"maintain date modified\"       "
msgstr "☑ 选项“保留修改日期”"

msgid "Maintains the last date modified"
msgstr "Maintains the last date modified"

msgid "Batch solve images using local astrometry.net"
msgstr "使用本地 astrometry.net 批量求解图像"

msgid "Solve the image using a local version of astrometry.net"
msgstr "Solve the image using a local version of astrometry.net"

msgid "Batch convert to FITS"
msgstr "批量转换为 FITS"

msgid "Convert the selected images to the FITS format."
msgstr "Convert the selected images to the FITS format."

msgid "Batch convert to TIFF"
msgstr "批量转换为 TIFF"

msgid "Convert the selected images to the 16 bit or 32 bit TIFF format."
msgstr "Convert the selected images to the 16 bit or 32 bit TIFF format."

msgid "Batch convert to TIFF, preserve file date"
msgstr "批量转换为 TIFF，并保留文件日期"

msgid "Batch convert to PBM/PFM"
msgstr "批量转换为 PBM/PFM"

msgid "Convert the selected images to the 16 bit PBM (Portable Bit Map) or 32 bit PFM (Portable Float Map) format."
msgstr "Convert the selected images to the 16 bit PBM (Portable Bit Map) or 32 bit PFM (Portable Float Map) format."

msgid "Set files date modified to DATE-OBS"
msgstr "将文件修改日期设为 DATE-OBS"

msgid "Set for all files the \"date modified\" to the value in keyword DATE-OBS. This is the start time of the exposure."
msgstr "Set for all files the \"date modified\" to the value in keyword DATE-OBS. This is the start time of the exposure."

msgid "Move images to path \"object, date, filter\""
msgstr "按“目标、日期、滤镜”移动图像"

msgid "Move selected images to a new directory based in the header info object name, exposure date and filter."
msgstr "Move selected images to a new directory based in the header info object name, exposure date and filter."

msgid "Batch convert bin2x2"
msgstr "批量转换 bin2x2"

msgid "Bin 2x2 all selected images"
msgstr "Bin 2x2 all selected images"

msgid "Batch convert bin3x3"
msgstr "批量转换 bin3x3"

msgid "Bin 3x3 all selected images"
msgstr "Bin 3x3 all selected images"

msgid "Batch Crop"
msgstr "批量裁剪"

msgid "Crop by coordinates"
msgstr "按坐标裁剪"

msgid "As set by pop-up menu \"set area\" of viewer or enter manually coordinates."
msgstr "As set by pop-up menu \"set area\" of viewer or enter manually coordinates."

msgid "Crop as the sample image in the viewer"
msgstr "按查看器中的样例图像裁剪"

msgid "Images could be cropped in ASTAP or by CCDCIEL selected sensor section "
msgstr "Images could be cropped in ASTAP or by CCDCIEL selected sensor section "

msgid "Rotate"
msgstr "旋转"

msgid "Rotate 90 degrees left"
msgstr "向左旋转 90 度"

msgid "Rotate the selected FITS images 90 degrees left"
msgstr "Rotate the selected FITS images 90 degrees left"

msgid "Rotate 90 degrees right"
msgstr "向右旋转 90 度"

msgid "Rotate the selected FITS images 90 degrees right"
msgstr "Rotate the selected FITS images 90 degrees right"

msgid "Rotate 180 degrees"
msgstr "旋转 180 度"

msgid "Rotate the selected FITS images 180 degrees."
msgstr "Rotate the selected FITS images 180 degrees."

msgid "Raw colour separation"
msgstr "RAW 颜色分离"

msgid "This will extract the colours from a raw DSLR/OCS image write them to separate files."
msgstr "This will extract the colours from a raw DSLR/OCS image write them to separate files."

msgid "Extract raw GREEN pixels and combine"
msgstr "提取并合并 RAW 绿色像素"

msgid "Will combine for each bayer submosaic the two green pixels. Check in advance the de-mosaic pattern in stack menu, tab stack method"
msgstr "Will combine for each bayer submosaic the two green pixels. Check in advance the de-mosaic pattern in stack menu, tab stack method"

msgid "Extract raw RED pixels"
msgstr "提取 RAW 红色像素"

msgid "Check in advance the de-mosaic pattern in stack menu, tab stack method"
msgstr "Check in advance the de-mosaic pattern in stack menu, tab stack method"

msgid "Extract raw BLUE pixels"
msgstr "提取 RAW 蓝色像素"

msgid "Bayer matrix pixel 11"
msgstr "拜耳阵列像素 11"

msgid "Pixels with position 11 in the Bayer matrix are extracted from the selected files."
msgstr "Pixels with position 11 in the Bayer matrix are extracted from the selected files."

msgid "Bayer matrix pixel 12"
msgstr "拜耳阵列像素 12"

msgid "Pixels with position 12 in the Bayer matrix are extracted from the selected files."
msgstr "Pixels with position 12 in the Bayer matrix are extracted from the selected files."

msgid "Bayer matrix pixel 21"
msgstr "拜耳阵列像素 21"

msgid "Pixels with position 21 in the Bayer matrix are extracted from the selected files."
msgstr "Pixels with position 21 in the Bayer matrix are extracted from the selected files."

msgid "Bayer matrix pixel 22"
msgstr "拜耳阵列像素 22"

msgid "Pixels with position 22 in the Bayer matrix are extracted from the selected files."
msgstr "Pixels with position 22 in the Bayer matrix are extracted from the selected files."

msgid "Remove longitude && latitude info from files"
msgstr "移除文件中的经纬度信息"

msgid "Batch compress FITS"
msgstr "批量压缩 FITS"

msgid "Compress all files using the CFITSIO utility program fpack. Works best for 32 bit floating point fits files. Original files will be kept."
msgstr "Compress all files using the CFITSIO utility program fpack. Works best for 32 bit floating point fits files. Original files will be kept."

msgid "Batch annotate asteroids && comets"
msgstr "批量标注小行星与彗星"

msgid "This will add asteroid or comet annotations to the fits header. Intended for the blinking routine or manual stacking. Batch solve the images first."
msgstr "This will add asteroid or comet annotations to the fits header. Intended for the blinking routine or manual stacking. Batch solve the images first."

msgid "Batch measure tilt and store to header keyword TILT"
msgstr "批量测量倾斜并写入头关键字 TILT"

msgid "A keyword TILT is added to the image headers. This keyword can be read by the configurable last column of tab lights"
msgstr "A keyword TILT is added to the image headers. This keyword can be read by the configurable last column of tab lights"

msgid "Image Inspection "
msgstr "图像检查"

msgid "--- Hidden inspector ---"
msgstr "--- 隐藏检查器 ---"

msgid "--- Hidden roundness"
msgstr "--- 隐藏圆度"

msgid "--- Hidden abberation"
msgstr "--- 隐藏像差"

msgid "Activate/deactivate auto de-mosaic"
msgstr "启用/停用自动去拜耳"

msgid "If checked, any new image in viewer will be demosaiced using bilinear interpolation."
msgstr "If checked, any new image in viewer will be demosaiced using bilinear interpolation."

msgid "De-mosaic Bayer matrix "
msgstr "拜耳阵列去拜耳"

msgid "Convert RAW to colour using interpolation.  Set first correct Bayer pattern in the stack menu."
msgstr "Convert RAW to colour using interpolation.  Set first correct Bayer pattern in the stack menu."

msgid "Auto correct colours."
msgstr "自动校正颜色。"

msgid "Will adjust color settings to get gray background and average white stars. This is the same function as in tab pixel math"
msgstr "Will adjust color settings to get gray background and average white stars. This is the same function as in tab pixel math"

msgid "Remove green and purple filter"
msgstr "移除绿色和紫色偏色"

msgid "Balances RGB to remove green and purple."
msgstr "Balances RGB to remove green and purple."

msgid "Inverse image"
msgstr "反相图像"

msgid "Inverse image. Saving will apply the changes the original image."
msgstr "Inverse image. Saving will apply the changes the original image."

msgid "Convert to mono"
msgstr "转换为单色"

msgid "Convert colour image to gray scale image"
msgstr "Convert colour image to gray scale image"

msgid "Bin or stretch"
msgstr "合并像素或拉伸"

msgid "Bin or stretch the image"
msgstr "Bin or stretch the image"

msgid "Bin 2x2"
msgstr "2x2 合并像素"

msgid "Bin the image 2x2"
msgstr "Bin the image 2x2"

msgid "Bin 3x3"
msgstr "3x3 合并像素"

msgid "Bin the image 3x3"
msgstr "Bin the image 3x3"

msgid "Stretch draw"
msgstr "拉伸绘制"

msgid "Like binning reduce the displayed resolution temporary using current zoom factor. To be used to create images of reduced resolution and to save to file or copy to clipboard."
msgstr "Like binning reduce the displayed resolution temporary using current zoom factor. To be used to create images of reduced resolution and to save to file or copy to clipboard."

msgid "Stretch draw to FITS"
msgstr "拉伸绘制到 FITS"

msgid "Convert current view to a FITS image. This will use the current contrast setting and reduce resolution. "
msgstr "Convert current view to a FITS image. This will use the current contrast setting and reduce resolution. "

msgid "Undo"
msgstr "撤销"

msgid "Undo last Bayer or binning action"
msgstr "Undo last Bayer or binning action"

msgid "Rotate image"
msgstr "旋转图像"

msgid "Rotate the image."
msgstr "Rotate the image."

msgid "Flip horizontal"
msgstr "水平翻转"

msgid "Flip the image horizontal. Saving will apply the change to the original image."
msgstr "Flip the image horizontal. Saving will apply the change to the original image."

msgid "Flip vertical"
msgstr "垂直翻转"

msgid "Flip the image vertical. Saving will apply the change to the original image."
msgstr "Flip the image vertical. Saving will apply the change to the original image."

msgid "Rotate arbitrary"
msgstr "任意角度旋转"

msgid "Rotate the image with the angle specified. Accurate algorithm but image quality will be reduced unless 90,180 or 270 degrees rotation."
msgstr "Rotate the image with the angle specified. Accurate algorithm but image quality will be reduced unless 90,180 or 270 degrees rotation."

msgid "Clean-up"
msgstr "清理"

msgid "Redraw image. Remove any markers except annotations. For removal annotations reload or remove annotations from FITS header."
msgstr "Redraw image. Remove any markers except annotations. For removal annotations reload or remove annotations from FITS header."

msgid "Calibrate photometry"
msgstr "校准测光"

msgid "Calibrate photometry using available star database (Gaia BP or V magnitude), Aperture setings are in tab photometry. Works best for raw/mono images. For colour images red channel will be used but accuracy will be less."
msgstr "Calibrate photometry using available star database (Gaia BP or V magnitude), Aperture setings are in tab photometry. Works best for raw/mono images. For colour images red channel will be used but accuracy will be less."

msgid "SQM report based on an image"
msgstr "基于图像生成 SQM 报告"

msgid "Will report the SQM value of the observation site. Use longer exposures. Avoid deepsky objects in the image"
msgstr "Will report the SQM value of the observation site. Use longer exposures. Avoid deepsky objects in the image"

msgid "Magnitude (measured) annotation"
msgstr "星等 (测量值) 标注"

msgid "Annotate stars with measured star magnitude"
msgstr "Annotate stars with measured star magnitude"

msgid "Star (database) annotation"
msgstr "恒星 (数据库) 标注"

msgid "Annotate all stars in the image. Plate solve the image first. For a G-database the indicated magnitude is Gaia blue. For a V-database the indicated magnitude is Johnson-V  and the following the difference between Gaia blue and red, positive for reddish objects. All in 1/10 of a magnitude."
msgstr "Annotate all stars in the image. Plate solve the image first. For a G-database the indicated magnitude is Gaia blue. For a V-database the indicated magnitude is Johnson-V  and the following the difference between Gaia blue and red, positive for reddish objects. All in 1/10 of a magnitude."

msgid "Unknown star annotation"
msgstr "未知恒星标注"

msgid "Annotate nova and minor planets using the online Gaia database up to about magnitude 20."
msgstr "Annotate nova and minor planets using the online Gaia database up to about magnitude 20."

msgid "Variable star annotation"
msgstr "变星标注"

msgid "Annotate all variable stars and comparison stars from the local database or AAVSO online database. Database setting is in tab Photometry."
msgstr "Annotate all variable stars and comparison stars from the local database or AAVSO online database. Database setting is in tab Photometry."

msgid "Asteroid && comet annotation"
msgstr "小行星与彗星标注"

msgid "Annotate asteroids"
msgstr "Annotate asteroids"

msgid "Deepsky (HyperLeda) annotation"
msgstr "深空 (HyperLeda) 标注"

msgid "Use the huge HyperLeda database for annotation.  Prior to this the image needs to be astrometric solved. Zoom in to get small font."
msgstr "Use the huge HyperLeda database for annotation.  Prior to this the image needs to be astrometric solved. Zoom in to get small font."

msgid "Deepsky annotation"
msgstr "深空标注"

msgid "This will place deep sky annotations on the image. Prior to this the image needs to be astrometric solved. Zoom in to get smaller font"
msgstr "This will place deep sky annotations on the image. Prior to this the image needs to be astrometric solved. Zoom in to get smaller font"

msgid "View"
msgstr "视图"

msgid "Image cleanup"
msgstr "清理图像"

msgid "Clear the image of annotations"
msgstr "Clear the image of annotations"

msgid "Centre lost windows"
msgstr "找回偏离屏幕的窗口"

msgid "Flip the image horizontal."
msgstr "Flip the image horizontal."

msgid "Flip image vertical."
msgstr "Flip image vertical."

msgid "Flip horizontal and vertical"
msgstr "水平和垂直翻转"

msgid "This is equivalent to 180° rotation."
msgstr "This is equivalent to 180° rotation."

msgid "Fit to window"
msgstr "适合窗口"

msgid "Fit to window."
msgstr "Fit to window."

msgid "Zoom 100%"
msgstr "缩放 100%"

msgid "Zoom to 100%. Image pixels will match with screen pixels."
msgstr "Zoom to 100%. Image pixels will match with screen pixels."

msgid "Annotations header visible"
msgstr "显示头部标注"

msgid "Switches the annotations on/off. The annotations are stored in the FITS files header with keyword ANNOTATE"
msgstr "Switches the annotations on/off. The annotations are stored in the FITS files header with keyword ANNOTATE"

msgid "North-East indicator image"
msgstr "显示东北方向指示"

msgid "Show a north-east indicator on the image."
msgstr "Show a north-east indicator on the image."

msgid "Star profile"
msgstr "恒星轮廓"

msgid "Show the star profile for the star at the mouse cursor."
msgstr "Show the star profile for the star at the mouse cursor."

msgid "Mount position"
msgstr "赤道仪位置"

msgid "Shows the mount position as a star and a large orientation indicator in the solved image. The center of the image is indicated as  tiny lime coloured square. "
msgstr "Shows the mount position as a star and a large orientation indicator in the solved image. The center of the image is indicated as  tiny lime coloured square. "

msgid "Constellations"
msgstr "星座"

msgid "Add the constellations to the image."
msgstr "Add the constellations to the image."

msgid "A, h grid"
msgstr "方位/高度网格"

msgid "Adds an azimuth & altitude grid to image"
msgstr "Adds an azimuth & altitude grid to image"

msgid "α, δ grid"
msgstr "赤经/赤纬网格"

msgid "Adds a right ascension & declination grid to image"
msgstr "Adds a right ascension & declination grid to image"

msgid "Centre position && date at bottom"
msgstr "底部显示中心位置与日期"

msgid "Add the centre position and date and time at the left bottom of the image. Font colour and font size can be set in the asteroid annotation menu."
msgstr "Add the centre position and date and time at the left bottom of the image. Font colour and font size can be set in the asteroid annotation menu."

msgid "Free text at bottom"
msgstr "底部自由文本"

msgid "Add free text to bottom of the image. Font colour and font size can be set in the asteroid annotation menu."
msgstr "Add free text to bottom of the image. Font colour and font size can be set in the asteroid annotation menu."

msgid "Zoom out"
msgstr "缩小"

msgid "Zoom in"
msgstr "放大"

msgid "&Help"
msgstr "帮助"

msgid "Show basic FITS header"
msgstr "显示基本 FITS 头"

msgid "Online help and webpage"
msgstr "在线帮助和网页"

msgid "Open the ASTAP webpage"
msgstr "Open the ASTAP webpage"

msgid "&About ASTAP"
msgstr "关于 ASTAP"

msgid "About this program"
msgstr "About this program"

msgid "Add annotation (▭)"
msgstr "添加标注 (▭)"

msgid "Add annotation text to current mouse position. Hold left mouse button down and pull a rectangle with mouse to extend connecting line. Add @ to the text for persistent annotations."
msgstr "Add annotation text to current mouse position. Hold left mouse button down and pull a rectangle with mouse to extend connecting line. Add @ to the text for persistent annotations."

msgid "Add rectangle with annotation (▭)"
msgstr "添加带标注的矩形 (▭)"

msgid "Add rectangle. Hold left mouse button down and pull a rectangle with mouse."
msgstr "Add rectangle. Hold left mouse button down and pull a rectangle with mouse."

msgid "Add marker"
msgstr "添加标记"

msgid "Add marker on image"
msgstr "Add marker on image"

msgid "Add object position"
msgstr "添加目标位置"

msgid "Add astronomical position of the object near the mouse position. Position is auto centered."
msgstr "Add astronomical position of the object near the mouse position. Position is auto centered."

msgid "Add object position short"
msgstr "添加目标位置简写"

msgid "Add object position in short IAU designation style. If there is no lock, no position wll be given. Use then the previouse menu option."
msgstr "Add object position in short IAU designation style. If there is no lock, no position wll be given. Use then the previouse menu option."

msgid "Add marker at α, δ position"
msgstr "在 α、δ 位置添加标记"

msgid "Place marker at specified α, δ position. "
msgstr "Place marker at specified α, δ position. "

msgid "Angular distance (▭)"
msgstr "角距离 (▭)"

msgid "Angular distance rigorous method."
msgstr "Angular distance rigorous method."

msgid "Measure total magnitude (▭, ⬭)"
